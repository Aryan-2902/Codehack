# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Long random string used to sign session JWTs (e.g. `openssl rand -base64 32`)
AUTH_SECRET="change-me"
# Cloudinary (listing photos). Uploads return 503 until these are set.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: let approved bookings be checked in at any time before they end (for live demos).
# DEMO_MODE="true"
# Optional AI suggestions (resource matching, incident summaries). Without these the app uses
# its built-in keyword matcher and template summaries, and sends nothing to any third party.
# AI_FEATURES="true"
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"
# AI_TIMEOUT_MS="20000"
