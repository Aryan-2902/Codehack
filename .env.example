# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Long random string used to sign session JWTs (e.g. `openssl rand -base64 32`)
AUTH_SECRET="change-me"
# Cloudinary (listing photos). Uploads return 503 until these are set.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: let approved bookings be checked in at any time before they end (for live demos).
# DEMO_MODE="true"
